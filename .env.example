# Supabase queue: Project Settings → API. Service role key, not anon.
# Run supabase/seek_job_enrichment_urls.sql once if the table is not already there.
# This process only reads rows where is_active = true. Linktal deactivates them after a successful ping.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# POST /api/job-research/enrichment-ingest. SCRAPE_COMPLETE_SECRET must equal the API's secret.
SCRAPE_COMPLETE_URL=https://your-api.example/api/job-research/enrichment-ingest
SCRAPE_COMPLETE_SECRET=a-long-random-shared-secret

# Optional. Defaults to the existing Seek job HTML upload Cloud Run service.
# GCS_UPLOAD_ENDPOINT=https://upload-seek-job-5658707854.asia-southeast1.run.app
